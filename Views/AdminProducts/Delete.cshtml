@model coffeeshop.Models.Product
@{
    Layout = "_AdminLayout";
}

<section class="admin-shell">
    <div class="admin-content">
        <div class="admin-form-card">
            <h1 class="mb-3">Delete Product</h1>

            <p>Are you sure you want to delete this product?</p>

            <div class="mb-4">
                <img src="@Model.ImageUrl" alt="@Model.Name"
                     style="width: 160px; height: 160px; object-fit: cover; border-radius: 16px;" />

                <h3 class="mt-3">@Model.Name</h3>
                <p>@Model.Price.ToString("C")</p>
            </div>

            <form asp-controller="AdminProducts" asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger">
                    Delete
                </button>

                <a asp-controller="AdminProducts" asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</section>