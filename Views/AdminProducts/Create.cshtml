@model coffeeshop.Models.Product
@{
    Layout = "_AdminLayout";
}

<section class="admin-shell">
    <div class="admin-content">
        <div class="admin-form-card">
            <h1 class="mb-4">Add Product</h1>

            <form asp-controller="AdminProducts" asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Name">Product name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Price">Price</label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ImageUrl">Image URL</label>
                    <input asp-for="ImageUrl" class="form-control" />
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Detail">Detail</label>
                    <textarea asp-for="Detail" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Detail" class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsTrendingProduct" class="form-check-input" />
                    <label asp-for="IsTrendingProduct" class="form-check-label">
                        Trending product
                    </label>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>

                <a asp-controller="AdminProducts" asp-action="Index" class="btn btn-secondary">
                    Back
                </a>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}