@model coffeeshop.Models.ContactMessage

<section class="contact-page">
    <div class="container">
        <div class="contact-card">
            <div class="contact-header">
                <h1>Get in Touch</h1>
                <p>One of our team will be in contact with you shortly.</p>
            </div>

            @if (TempData["ContactSuccess"] != null)
            {
                <div class="alert alert-success text-center">
                    @TempData["ContactSuccess"]
                </div>
            }

            <form asp-controller="Home" asp-action="Contact" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Name">Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Enter your name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Message">Message</label>
                    <textarea asp-for="Message" class="form-control" rows="6"
                              placeholder="Write your message"></textarea>
                    <span asp-validation-for="Message" class="text-danger"></span>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary contact-btn">
                        Send Message
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}