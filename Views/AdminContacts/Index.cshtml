@model IEnumerable<coffeeshop.Models.ContactMessage>

@{
    Layout = "_AdminLayout";
}

<section class="admin-shell">
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="admin-brand">SB ADMIN 2</div>

            <div class="admin-section-label">Manage</div>
            <nav class="admin-menu">
                <a asp-controller="AdminProducts" asp-action="Index">Product</a>
                <a asp-controller="AdminOrders" asp-action="Index">Order</a>
                <a class="active" asp-controller="AdminContacts" asp-action="Index">Contact</a>
                <a asp-controller="Home" asp-action="Index">Back to Website</a>
            </nav>
        </aside>

        <main class="admin-content">
            <div class="admin-card">
                <div class="admin-title-row">
                    <div>
                        <h1>Manage Contacts</h1>
                        <p>View messages sent by customers.</p>
                    </div>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <h4>No contact messages yet</h4>
                        <p class="text-muted">Messages from users will appear here.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table admin-table align-middle">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Message</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                    <th>View</th>
                                    <th>Delete</th>
                                </tr>
                            </thead>

                            <tbody>
                                @{
                                    var stt = 1;
                                }

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@stt</td>
                                        <td>@item.Name</td>
                                        <td>@item.Email</td>
                                        <td>
                                            @if (item.Message.Length > 60)
                                            {
                                                @(item.Message.Substring(0, 60) + "...")
                                            }
                                            else
                                            {
                                                @item.Message
                                            }
                                        </td>
                                        <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (item.IsRead)
                                            {
                                                <span class="badge bg-secondary">Read</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">New</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-controller="AdminContacts"
                                               asp-action="Detail"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                View
                                            </a>
                                        </td>
                                        <td>
                                            <form asp-controller="AdminContacts"
                                                  asp-action="Delete"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Delete this contact message?');">
                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>

                                    stt++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </main>
    </div>
</section>